---
// Set-letter design system — see DESIGN.md. Decided in /plan-design-review
// 2026-08-20 (D12/D13): Source Serif 4 for display, Source Sans 3 for body,
// warm paper / ink / one terracotta accent. Light-only (D5).
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Source Sans 3 Variable';
    --aw-font-serif: 'Source Serif 4 Variable';
    --aw-font-heading: 'Source Serif 4 Variable';

    /* Letter palette (DESIGN.md) */
    --paper: #faf8f4;
    --ink: #211c16;
    --muted: #5a544c; /* AA on --paper at 16px */
    --rule: #d8d2c8;
    --accent: #b5502f; /* terracotta — evidence rule + small emphasis only */
    --focus: #1a56db;

    /* AstroWind token mapping so Header/Footer inherit the letter look */
    --aw-color-primary: var(--ink);
    --aw-color-secondary: var(--ink);
    --aw-color-accent: var(--accent);

    --aw-color-text-heading: var(--ink);
    --aw-color-text-default: var(--ink);
    --aw-color-text-muted: var(--muted);
    --aw-color-bg-page: var(--paper);

    --aw-color-bg-page-dark: var(--paper); /* light-only site (D5) */

    ::selection {
      background-color: #efe7d8;
    }
  }
</style>
